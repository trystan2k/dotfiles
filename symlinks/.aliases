alias gcb="git checkout -b"
alias gl="git pull"
alias gf="git fetch"
alias gzup="git zup"
alias gmend="git amend"

gsmart() {
  # Check if there are staged changes
  if [ -z "$(git diff --cached --name-only)" ]; then
    echo "No staged changes found. Use 'git add' to stage files first."
    return 1
  fi

  # Check if opencode command is available
  if ! command -v opencode >/dev/null 2>&1; then
    echo "Error: Failed to find opencode command. Is it installed?"
    return 1
  fi

  # Generate commit message using claude
  commit_message=$(opencode run "Look at the staged git changes and create a concise commit message (following the pattern used in the current repo) that describes what was changed. Return only the commit message, nothing else.")

  if [ -z "$commit_message" ]; then
    echo "Error: Failed to generate commit message"
    return 1
  fi

  echo "$commit_message"

  git commit -m "$commit_message" --edit
}

