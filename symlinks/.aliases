# change mac addresss and get unlimitted wifi in airport or for safety
function change_mac_address() {
  local mac=$(openssl rand -hex 6 | sed 's/\(..\)/\1:/g; s/.$//')
  sudo ifconfig en0 ether "$mac"
  sudo ifconfig en0 down
  sudo ifconfig en0 up
  echo "Your new physical address is $mac"
}

# download a subfolder of a github repository
function dl_github_sub() {
  folder=$(echo "$1" | sed -e 's/.*\///g')
  svn checkout "${1:gs/tree\/master/trunk}"
  rm -rf "./$folder/.svn"
}

# Convert a video file to MP4 using ffmpeg
function convert_to_mp4() {
  mkdir -p converted
  ffmpeg -i "$1" -nostdin -c:v libx264 -c:a aac -movflags +faststart -vf format=yuv420p "converted/${1%.*}.mp4"
}

# Convert a video file to GIF using ffmpeg
function convert_to_gif() {
  mkdir -p converted
  ffmpeg -i "$1" -filter_complex "[0:v] fps=12,scale=1024:-1,split [a][b];[a] palettegen [p];[b][p] paletteuse" "converted/${1%.*}-temp.gif"
  gifsicle -O3 --lossy=100 "converted/${1%.*}-temp.gif" -o "converted/${1%.*}.gif"
  rm "converted/${1%.*}-temp.gif"
  mkdir -p to_delete
  mv $1 to_delete

}

# Convert all video files in current folder to MP4 using ffmpeg
function convert_all_to_mp4() {
  find . -type f -exec file --mime-type {} + | grep "video/" | awk -F ":" '{print $1}' | while read line; do
    convert_to_mp4 $line
    retVal=$?
    if [ $retVal -eq 0 ]; then
      mkdir -p to_delete
      mv $line to_delete
    fi
  done
}

# Convert a video file to GIF using ffmpeg
function convert_to_gif() {
  mkdir -p converted
  ffmpeg -i "$1" -filter_complex "[0:v] fps=12,scale=1024:-1,split [a][b];[a] palettegen [p];[b][p] paletteuse" "converted/${1%.*}-temp.gif"
  gifsicle -O3 --lossy=100 "converted/${1%.*}-temp.gif" -o "converted/${1%.*}.gif"
  rm "converted/${1%.*}-temp.gif"
  mkdir -p to_delete
  mv $1 to_delete
}

# Kill processes listening on a given port
function kill_port() {
  lsof -i tcp:$1 | awk 'NR!=1 {print $2}' | xargs kill
}

function port() {
    if [[ "$1" == "help" || "$1" == "-h" || -z "$1" ]]; then
        echo "${C_CYAN}🔌 port${C_NC}: See what's running on a port and optionally kill it."
        echo "Usage: ${C_YELLOW}port <number> [kill]${C_NC}"
        echo "Examples:"
        echo "  port 8080       (Views processes on port 8080)"
        echo "  port 3000 kill  (Kills the process running on port 3000)"
        return 0
    fi

    local target_port=$1
    if [[ "$2" == "kill" ]]; then
        echo "${C_RED}Attempting to kill process on port $target_port...${C_NC}"
        local pid=$(lsof -t -i:"$target_port")
        if [[ -n "$pid" ]]; then
            kill -9 $pid
            echo "${C_GREEN}✅ Process $pid killed successfully.${C_NC}"
        else
            echo "${C_YELLOW}⚠️  No process found running on port $target_port.${C_NC}"
        fi
    else
        echo "${C_CYAN}Processes listening on port $target_port:${C_NC}"
        lsof -i :"$target_port" || echo "${C_YELLOW}No active processes on this port.${C_NC}"
    fi
}

# Alias suffix to open file in cat, when file is 'executed'
alias -s {json,env,gitignore,md,html,css,toml}=cat

# Alias suffix to execute git clone when a git url is 'executed'
alias -s git="git clone"

# colored cat command
alias cat='bat'

# Hooks to show execution time of commands
preexec() {
  timer=$(gdate +%s.%N)
}

precmd() {
  if [ -n "$timer" ]; then
    now=$(gdate +%s.%N)
    elapsed=$(echo "$now - $timer" | bc)
    timer_show=$(printf "%.2f" $elapsed)
    echo "Execution time: ${timer_show}s"
    unset timer
  fi
}

# NPM Alias

updateNPMDependencies() {
  if [[ $@ == *"--help"* ]]; then
    echo "Example: updateNPMDependencies --filter /^@client-components/ --upgrade --deep --format group --target minor"
    echo "For more information, check https://github.com/raineorshine/npm-check-updates"
    return 0;
  fi

  npx npm-check-updates $@
}

# Alias for npm install -g, to install global tools into $PATH_TO_GLOBAL_NODE_MODULES
npmig() {
    if [ -z "$PATH_TO_GLOBAL_NODE_MODULES" ]; then
        echo "Error: PATH_TO_GLOBAL_NODE_MODULES environment variable is not set"
        return 1
    fi
    
    if [ ! -d "$PATH_TO_GLOBAL_NODE_MODULES" ]; then
        mkdir -p "$PATH_TO_GLOBAL_NODE_MODULES"
    fi
    
    local action=$1
    if [ -z "$action" ]; then
        action="install"
    else if [ "$action" = "update" ] || [ "$action" = "upgrade" ]; then
        action="install"
        shift  # Remove the action from arguments
    else if [ "$action" = "info" ] || [ "$action" = "list" ] || [ "$action" = "outdated" ]; then
        shift
    fi
    fi
    fi
    
    npm "$action" --prefix "$PATH_TO_GLOBAL_NODE_MODULES" "$@"
}

# Copy current folder path to clipboard
alias cpwd="pwd | tr -d '\n' | pbcopy"

# Move and copy files with more information/confirmation
alias mv="mv -iv"
alias cp="cp -riv"

# Format JSON
function cbjson() {
    if [[ "$1" == "help" || "$1" == "-h" ]]; then
        echo "${C_CYAN}📋 cbjson${C_NC}: Formats minified JSON."
        echo "Usage:"
        echo "  ${C_YELLOW}cbjson${C_NC}          - Formats JSON currently in your clipboard"
        echo "  ${C_YELLOW}cbjson <file>${C_NC}   - Formats a specific JSON file"
        return 0
    fi

    local input_data
    local source_name

    if [[ -n "$1" ]]; then
        if [[ ! -f "$1" ]]; then
            echo "${C_RED}❌ Error: File '$1' not found.${C_NC}"
            return 1
        fi
        input_data=$(cat "$1")
        source_name="file '$1'"
    else
        input_data=$(pbpaste)
        source_name="clipboard"
    fi

    # Format JSON using Python safely
    local formatted=$(echo "$input_data" | python3 -c 'import sys, json; print(json.dumps(json.load(sys.stdin), indent=2))' 2>/dev/null)

    if [[ -n "$formatted" ]]; then
        echo "$formatted" | pbcopy
        echo "${C_GREEN}✅ JSON from $source_name formatted and copied to clipboard!${C_NC}"
        echo "${C_CYAN}Preview:${C_NC}"
        # If jq is installed, use it for color output in terminal, otherwise just echo
        if command -v jq >/dev/null 2>&1; then
            echo "$formatted" | jq -C '.' | head -n 15
        else
            echo "$formatted" | head -n 15
        fi
        echo "${C_YELLOW}... (truncated) ...${C_NC}"
    else
        echo "${C_RED}❌ Error: $source_name does not contain valid JSON data.${C_NC}"
    fi
}

# a timer that comes and finds you
function countdown() {
    if [[ "$1" == "help" || "$1" == "-h" ]]; then
        echo "${C_CYAN}⏳ countdown${C_NC}: A simple terminal timer with notifications."
        echo "Usage: ${C_YELLOW}countdown <time>[s|m|h]${C_NC}"
        echo "Examples: countdown 45, countdown 5m, countdown 1h"
        return 0
    fi

    local input=${1:-60}
    local seconds=0

    if [[ $input == *m ]]; then seconds=$((${input%m} * 60))
    elif [[ $input == *h ]]; then seconds=$((${input%h} * 3600))
    elif [[ $input == *s ]]; then seconds=${input%s}
    else seconds=$input; fi

    if ! [[ "$seconds" =~ ^[0-9]+$ ]]; then
        echo "${C_RED}❌ Invalid time format.${C_NC} Use numbers, optionally followed by m or h."
        return 1
    fi

    echo "${C_CYAN}Starting timer for $input...${C_NC}"
    while [ "$seconds" -gt 0 ]; do
        printf "\r${C_YELLOW}⏳ Time remaining: %02d:%02d${C_NC}\033[0K" $((seconds/60)) $((seconds%60))
        sleep 1
        : $((seconds--))
    done

    printf "\r\033[0K"
    echo "${C_GREEN}🔔 Time's up! ($input)${C_NC}"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        osascript -e "display notification \"Your $input timer has finished!\" with title \"⏳ Countdown\" sound name \"Glass\""
        say "Timer is done" >/dev/null 2>&1 &!
    else
        echo -e "\a"
    fi
}

# your folder, on any phone, in three seconds
function webshare() {
    if [[ "$1" == "help" || "$1" == "-h" || "$1" == "--help" ]]; then
        echo "${C_CYAN}📁 webshare${C_NC}: Instantly serve the current directory over HTTP with a beautiful UI."
        echo "Usage: ${C_YELLOW}webshare [port] [-o]${C_NC}"
        echo ""
        echo "Options:"
        echo "  ${C_YELLOW}-o, --open${C_NC}     Automatically open the server in your default browser"
        echo ""
        echo "Examples:"
        echo "  webshare             (Serves on port 8000 by default)"
        echo "  webshare 3000        (Serves on port 3000)"
        echo "  webshare 8080 -o     (Serves on 8080 and opens browser)"
        return 0
    fi

    local port=8000
    local open_browser=0

    for arg in "$@"; do
        case "$arg" in
            -o|--open) open_browser=1 ;;
            -*) echo "${C_RED}❌ Unknown option: $arg${C_NC}"; return 1 ;;
            *)
                if [[ "$arg" =~ ^[0-9]+$ ]]; then port=$arg
                else echo "${C_RED}❌ Invalid port: $arg${C_NC}"; return 1; fi
                ;;
        esac
    done

    while lsof -Pi :$port -sTCP:LISTEN -t >/dev/null; do
        echo "${C_YELLOW}⚠️  Port $port is in use. Trying $((port+1))...${C_NC}"
        port=$((port+1))
    done

    local local_ip=$(route -n get default 2>/dev/null | grep 'interface:' | awk '{print $2}' | xargs ipconfig getifaddr 2>/dev/null)
    [[ -z "$local_ip" ]] && local_ip="127.0.0.1"

    # Friendly Bonjour hostname, detected dynamically (e.g. http://my-macbook.local:8000)
    local host_name=$(scutil --get LocalHostName 2>/dev/null)
    local local_alias=""
    [[ -n "$host_name" ]] && local_alias="http://${host_name}.local:$port"

    echo "${C_GREEN}✅ Web server is running!${C_NC}"
    echo "${C_CYAN}📂 Serving path:${C_NC} $(pwd)"
    echo "------------------------------------------------------------"
    echo "${C_MAGENTA}📱 How to use & share:${C_NC}"
    echo " • ${C_YELLOW}For yourself:${C_NC} Click or open ${C_GREEN}http://localhost:$port${C_NC}"
    echo " • ${C_YELLOW}For others:${C_NC}   Tell them to go to one of these links on their device:"
    echo "                 ${C_GREEN}http://$local_ip:$port${C_NC}   (Always works)"
    if [[ -n "$local_alias" ]]; then
        echo "                 ${C_CYAN}$local_alias${C_NC}  (Friendly name, works on most devices)"
    fi
    echo "                 ${C_YELLOW}(Note: They must be on the same Wi-Fi/network)${C_NC}"
    echo "------------------------------------------------------------"
    echo "${C_YELLOW}Press Ctrl+C to stop the server${C_NC}"
    echo ""

    if [[ $open_browser -eq 1 ]]; then
        open "http://localhost:$port"
    fi

    local py_script=$(cat <<'EOF'
import http.server, socketserver, os, sys, urllib.parse, html, io

PORT = int(sys.argv[1])

class BeautifulHandler(http.server.SimpleHTTPRequestHandler):
    def list_directory(self, path):
        try:
            files = os.listdir(path)
        except os.error:
            self.send_error(404, "No permission to list directory")
            return None

        files.sort(key=lambda a: a.lower())

        displaypath = html.escape(urllib.parse.unquote(self.path))
        enc = sys.getfilesystemencoding()

        r = []
        r.append('<!DOCTYPE html><html><head><meta charset="utf-8">')
        r.append('<meta name="viewport" content="width=device-width, initial-scale=1">')
        r.append('<title>Shared Files</title>')
        r.append('''<style>
            body { font-family: system-ui, -apple-system, sans-serif; background: #121212; color: #e0e0e0; margin: 0; padding: 20px; }
            .container { max-width: 800px; margin: 0 auto; background: #1e1e1e; border-radius: 12px; padding: 20px; box-shadow: 0 8px 16px rgba(0,0,0,0.5); }
            h1 { margin-top: 0; font-size: 1.4rem; border-bottom: 1px solid #333; padding-bottom: 15px; color: #fff; word-break: break-all; }
            ul { list-style: none; padding: 0; margin: 0; }
            li { border-bottom: 1px solid #2a2a2a; }
            li:last-child { border-bottom: none; }
            a { display: flex; align-items: center; padding: 12px 10px; color: #bbb; text-decoration: none; font-size: 16px; border-radius: 8px; transition: all 0.2s; word-break: break-word; }
            a:hover { background: #2a2a2a; color: #fff; transform: translateX(4px); }
            .icon { font-size: 24px; margin-right: 15px; min-width: 30px; text-align: center; }
            @media (max-width: 600px) { body { padding: 10px; } .container { padding: 15px; } }
        </style>''')
        r.append('</head><body><div class="container">')
        r.append('<h1>📡 Network Share <br><span style="color:#888; font-size:1rem; font-weight:normal;">%s</span></h1>' % displaypath)
        r.append('<ul>')

        if self.path != "/":
            r.append('<li><a href=".."><span class="icon">🔙</span> Parent Directory</a></li>')

        for name in files:
            if name.startswith('.'):
                continue

            fullname = os.path.join(path, name)
            displayname = linkname = name
            icon = "📄"

            if os.path.isdir(fullname):
                displayname = name + "/"
                linkname = name + "/"
                icon = "📁"
            else:
                ext = name.lower().split('.')[-1] if '.' in name else ''
                if ext in ['mkv', 'mp4', 'avi', 'mov', 'webm']: icon = "🎬"
                elif ext in ['jpg', 'jpeg', 'png', 'gif', 'webp']: icon = "🖼️"
                elif ext in ['mp3', 'wav', 'flac', 'm4a']: icon = "🎵"
                elif ext in ['zip', 'rar', '7z', 'tar', 'gz']: icon = "📦"
                elif ext in ['pdf']: icon = "📕"
                elif ext in ['txt', 'md', 'csv', 'json']: icon = "📝"
                elif ext in ['py', 'js', 'html', 'css', 'java', 'cpp', 'sh']: icon = "💻"

            r.append('<li><a href="%s"><span class="icon">%s</span> %s</a></li>'
                     % (urllib.parse.quote(linkname, errors='surrogatepass'), icon, html.escape(displayname)))

        r.append('</ul></div></body></html>')

        encoded = ''.join(r).encode(enc, 'surrogateescape')
        f = io.BytesIO()
        f.write(encoded)
        f.seek(0)
        self.send_response(200)
        self.send_header("Content-type", "text/html; charset=%s" % enc)
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        return f

class QuietServer(socketserver.TCPServer):
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        import sys
        if issubclass(sys.exc_info()[0], (BrokenPipeError, ConnectionResetError)):
            return
        super().handle_error(request, client_address)

with QuietServer(("", PORT), BeautifulHandler) as httpd:
    httpd.serve_forever()
EOF
)

    python3 -c "$py_script" "$port"
}

#shellcheck source=/dev/null
[ -f "$HOME/.aliases.local" ] && source "$HOME/.aliases.local"